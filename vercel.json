{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "rewrites": [
    {
      "source": "/admin",
      "destination": "/admin.html"
    },
    {
      "source": "/invite/:token",
      "destination": "/index.html"
    },
    {
      "source": "/api/:path*",
      "destination": "/api/index?path=:path*"
    }
  ]
}
